#!/bin/sh
# Keep the local Xcode / Capacitor iOS project in sync before every push.
# Skip with: SKIP_IOS_PREPARE=1 git push

if [ "$SKIP_IOS_PREPARE" = "1" ]; then
  echo "Skipping ios:prepare (SKIP_IOS_PREPARE=1)"
  exit 0
fi

# Only when pushing to a GitHub remote (origin or any *github.com* URL)
remote_name="$1"
remote_url="$2"
case "$remote_url" in
  *github.com*|*github*)
    ;;
  "")
    # Older git may omit URL; still prepare for safety on named remotes
    ;;
  *)
    echo "Remote is not GitHub — skipping ios:prepare"
    exit 0
    ;;
esac

echo ""
echo "↻ ios:prepare — building web assets and syncing into Xcode before push…"
echo ""

npm run ios:prepare
status=$?
if [ $status -ne 0 ]; then
  echo ""
  echo "ios:prepare failed — push aborted. Fix the build, or push with SKIP_IOS_PREPARE=1"
  exit $status
fi

echo ""
echo "✅ Xcode iOS project updated. Continue with Archive in Xcode when ready."
echo ""
exit 0
