# Client (Vite) — baked in at `vite build`. Set these on Railway Build variables.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_USDA_API_KEY=your-usda-api-key
VITE_REVENUECAT_API_KEY=your-revenuecat-public-sdk-key
VITE_APP_URL=https://www.bytewisenutritionist.com
# Required for Capacitor iOS/Android: native app calls this host for /api/* (copy to .env before npm run ios:prepare)
# Supabase Auth → URL Configuration — add ALL of these to Redirect URLs:
# https://your-domain/auth/confirm
# https://your-domain/reset-password
# https://your-domain/verify-email
# (include both www and non-www if you use both)
VITE_DEVELOPMENT_MODE=false

# Server (Express) — Railway runtime variables. Required for food ID, auth, and meals.
NODE_ENV=production
PORT=5000
# Leave unset on Railway (app binds 0.0.0.0). Never set HOST to db.*.supabase.co.
HOST=0.0.0.0
APP_URL=https://www.bytewisenutritionist.com

# Prefer Session pooler on Railway (IPv4-friendly). Supabase → Connect → Session pooler.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# supabaseAuth.ts reads SUPABASE_SERVICE_KEY; supabaseStorage.ts reads SUPABASE_SERVICE_ROLE_KEY. Set both to the service role key.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

USDA_API_KEY=your-usda-fooddata-central-key
GOOGLE_API_KEY=your-gemini-api-key

REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret
SESSION_SECRET=generate-a-long-random-string
